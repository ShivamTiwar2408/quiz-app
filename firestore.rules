rules_version = '2';
// Recallr — Firestore security rules.
// Each user can read and write ONLY their own data under users/{uid}/**.
// All question content is bundled with the app (public static asset), so no
// question data lives in Firestore and nothing else is readable here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
