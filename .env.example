# Firebase web app config — copy to .env.local and fill from the Firebase
# console: Project settings → General → Your apps → SDK setup and configuration.
# These are public client identifiers (safe to ship); security is enforced by
# Firestore rules + Firebase Auth, not by hiding these values.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
